# NPC Simulator — AI configuration template.
# Copy to `.env` and fill in:  cp .env.example .env
# `.env` is git-ignored; secrets must never be committed.

# --------------------------------------------------------------------------
# Backend selection: tiered routing (large hosted models only for hard tasks).
#   LLM_BACKEND        — hard tasks: proposal + consequence (default joingonka)
#   LLM_SIMPLE_BACKEND — simple tasks: selection + semantic (default ollama)
#   joingonka  — hosted gateway (needs JOINGONKA_API_KEY below)
#   laya-local — locally served model (needs `npm run setup:laya` first)
#   ollama     — local Ollama server (needs `npm run setup:ollama` first)
# Per-task overrides (optional): LLM_BACKEND_PROPOSAL, LLM_BACKEND_SELECTION,
#   LLM_BACKEND_CONSEQUENCE, LLM_BACKEND_SEMANTIC.
# Simple-tier model override (optional): LLM_SIMPLE_MODEL
#   (e.g. LLM_SIMPLE_MODEL=huihui_ai/llama3.2-abliterate:3b for the fast 3B).
# Override per run without editing this file:
#   npm run start:text -- --provider ollama --model fluffy/l3-8b-stheno-v3.2
# --------------------------------------------------------------------------
LLM_BACKEND=joingonka
LLM_SIMPLE_BACKEND=ollama

# --------------------------------------------------------------------------
# Hosted provider: JoinGonka gateway (OpenAI-compatible).
# Get an API key at https://gate.joingonka.ai/dashboard
# --------------------------------------------------------------------------
JOINGONKA_API_KEY=
# JOINGONKA_BASE_URL=https://gate.joingonka.ai/v1
# JOINGONKA_MODEL=zai-org/GLM-5.3-Flash

# --------------------------------------------------------------------------
# Local provider: model served on this machine behind an OpenAI-compatible
# endpoint (llama.cpp --server, Ollama, vLLM, or a compatible gateway).
# --------------------------------------------------------------------------
# LAYA_BASE_URL=http://127.0.0.1:8080/v1
# LAYA_MODEL=laya
# LAYA_API_KEY=

# NOTE: `npm run serve:laya` (laya-serve) exposes the Jev-compatible typed-
# decisions API at POST http://127.0.0.1:8000/v1/systemone — that is NOT an
# OpenAI Chat Completions endpoint, so do NOT point LAYA_BASE_URL at it.
# LAYA_BASE_URL is for OpenAI-compatible local servers only.

# --------------------------------------------------------------------------
# Local Ollama provider: any model served by `ollama serve` behind its
# OpenAI-compatible endpoint. Recommended uncensored models (pulled by
# `npm run setup:ollama`):
#   fluffy/l3-8b-stheno-v3.2          — L3 8B Stheno (primary, ~4.9 GB)
#   huihui_ai/llama3.2-abliterate:3b  — Llama 3.2 3B abliterated (fast, ~2.2 GB)
# --------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=fluffy/l3-8b-stheno-v3.2
# OLLAMA_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# --------------------------------------------------------------------------
# Local Laya server settings (used by scripts/serve-laya.sh + diagnose).
# --------------------------------------------------------------------------
# LAYA_DEVICE=cpu
# LAYA_PRELOAD=1
# LAYA_SERVE_URL=http://127.0.0.1:8000
# LAYA_VENV=
# LAYA_PYTHON=python3

# --------------------------------------------------------------------------
# Generation tuning (applies to whichever backend is active).
# Roleplay sweet spot: temperature 0.8-1.0, repeat_penalty 1.1-1.15.
# --------------------------------------------------------------------------
# LLM_TIMEOUT_MS=60000
# LLM_TEMPERATURE=0.9
# LLM_REPEAT_PENALTY=1.1
# LLM_MAX_TOKENS=1500
