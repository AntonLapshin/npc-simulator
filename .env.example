# NPC Simulator — AI configuration template.
# Copy to `.env` and fill in:  cp .env.example .env
# `.env` is git-ignored; secrets must never be committed.
#
# TWO kinds of variables live here:
#   LLM_*     — read by the simulator itself (resolveLlmEnv).
#   OLLAMA_*  — read by the `ollama serve` daemon, NOT the simulator,
#               with one exception: OLLAMA_MODEL (which model the simulator
#               requests) is simulator-read despite its prefix.
#               The server-side OLLAMA_* only take effect if the server starts
#               with them in its environment: use `npm run ollama:serve`
#               (scripts/start-ollama.sh), which exports the OLLAMA_* lines
#               from `.env` before launching. Starting ollama any other way
#               silently ignores them.

# --------------------------------------------------------------------------
# Ollama server (RTX 5070 Ti / 16 GB VRAM optimal defaults — active).
# Read by `ollama serve`; applied via `npm run ollama:serve`.
# --------------------------------------------------------------------------
# Keep weights resident between turns (a turn fires several LLM calls;
# default 5m would cold-start mid-run).
OLLAMA_KEEP_ALIVE=30m
# Serial workload — one request at a time. Avoids duplicate KV-cache slots
# competing for VRAM (default 4).
OLLAMA_NUM_PARALLEL=1
# Faster attention kernels on Blackwell; also enables KV-cache quantization.
OLLAMA_FLASH_ATTENTION=1

# --------------------------------------------------------------------------
# Backend selection: tiered routing (large hosted models only for hard tasks).
#   LLM_BACKEND        — hard tasks: proposal + consequence (default joingonka)
#   LLM_SIMPLE_BACKEND — simple tasks: selection + semantic (default ollama)
#   joingonka  — hosted gateway (needs JOINGONKA_API_KEY below)
#   laya-local — locally served model (needs `npm run setup:laya` first)
#   ollama     — local Ollama server (needs `npm run setup:ollama` first)
# Per-task overrides (optional): LLM_BACKEND_PROPOSAL, LLM_BACKEND_SELECTION,
#   LLM_BACKEND_CONSEQUENCE, LLM_BACKEND_SEMANTIC.
# Simple-tier model override (optional): LLM_SIMPLE_MODEL
#   (e.g. LLM_SIMPLE_MODEL=huihui_ai/llama3.2-abliterate:3b for the fast 3B).
# Override per run without editing this file:
#   npm run start:text -- --provider ollama --model qwen3:14b
# --------------------------------------------------------------------------
LLM_BACKEND=joingonka
LLM_SIMPLE_BACKEND=ollama

# --------------------------------------------------------------------------
# Hosted provider: JoinGonka gateway (OpenAI-compatible).
# Get an API key at https://gate.joingonka.ai/dashboard
# --------------------------------------------------------------------------
JOINGONKA_API_KEY=
# JOINGONKA_BASE_URL=https://gate.joingonka.ai/v1
# JOINGONKA_MODEL=zai-org/GLM-5.3-Flash

# --------------------------------------------------------------------------
# Local provider: model served on this machine behind an OpenAI-compatible
# endpoint (llama.cpp --server, Ollama, vLLM, or a compatible gateway).
# --------------------------------------------------------------------------
# LAYA_BASE_URL=http://127.0.0.1:8080/v1
# LAYA_MODEL=laya
# LAYA_API_KEY=

# NOTE: `npm run serve:laya` (laya-serve) exposes the Jev-compatible typed-
# decisions API at POST http://127.0.0.1:8000/v1/systemone — that is NOT an
# OpenAI Chat Completions endpoint, so do NOT point LAYA_BASE_URL at it.
# LAYA_BASE_URL is for OpenAI-compatible local servers only.

# --------------------------------------------------------------------------
# Local Ollama provider: any model served by `ollama serve` behind its
# OpenAI-compatible endpoint. Recommended models (pulled by
# `npm run setup:ollama`):
#   qwen3:14b                         — Qwen3 14B (default primary, ~9.3 GB; Exp-6)
#   fluffy/l3-8b-stheno-v3.2          — L3 8B Stheno (legacy primary, ~4.9 GB)
#   huihui_ai/llama3.2-abliterate:3b  — Llama 3.2 3B abliterated (fast, ~2.2 GB)
# --------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Default model — must be one that `npm run setup:ollama` actually pulls
# (it pulls qwen3:14b by default; use --only to pick a subset).
# NOTE: despite the prefix, OLLAMA_MODEL is read by the SIMULATOR (which
# model to request), not by `ollama serve`. Use npc-qwen3-14b for the
# tuned variant (num_gpu 999, num_ctx 4096) once setup:ollama has built it.
OLLAMA_MODEL=qwen3:14b
# OLLAMA_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# --------------------------------------------------------------------------
# Local Laya server settings (used by scripts/serve-laya.sh + diagnose).
# --------------------------------------------------------------------------
# LAYA_DEVICE=cpu
# LAYA_PRELOAD=1
# LAYA_SERVE_URL=http://127.0.0.1:8000
# LAYA_VENV=
# LAYA_PYTHON=python3

# --------------------------------------------------------------------------
# Laya decision layer (LAYA_PLAN.md phases 3–4). EVERYTHING IS OFF BY DEFAULT
# until Phase 5 validates it — the chat path stays the default behavior.
# The decision module's own defaults differ; the engine-facing values below
# are what actually apply (see readLayaRuntimeConfig in src/config.ts).
#
#   LAYA_URL=http://127.0.0.1:8000 — laya-serve endpoint (POST /v1/systemone).
#   LAYA_MODE=off|static|dynamic    — off: today's behavior (default).
#     static: fixed decision diagrams (selection cascade, judge set, triage,
#     salience). dynamic: the question planner generates the selection
#     diagram per turn (cached), with static fallback on any planner failure.
#   LAYA_SELECTION=1 — intent-first ordering: run the intent cascade, narrow
#     the proposal prompt to the decided intent, and use the Laya selection
#     engine (chat selection engine stays the injected fallback). Default 0.
#   LAYA_JUDGE=1 — Laya semantic judge (one batched decide per action)
#     instead of the chat judge. Default 0. Quote extraction stays
#     deterministic either way.
#   LAYA_TRIAGE=1 — gate observer thought/emotion patches on one batched
#     "notable inner reaction?" noul per perceiving observer (default 0).
#     Directly-addressed observers always keep their patches.
#   LAYA_SALIENCE=1 — one 1–5 salience score per turn gates model-emitted
#     memoriesAppend/beliefsAppend (default 0). The deterministic memory
#     append is the floor and always applies.
#   LAYA_PLANNER=1 — dynamic mode only: per-turn diagram generation via a
#     low-temperature chat LLM (default 0).
#   LAYA_PLAUSIBILITY=1 — advisory 1–5 plausibility score per object/position
#     patch; scores ≤2 append a note to retry feedback (default 0; NEVER
#     blocks or invalidates — advisory only).
#   LAYA_CONFIDENCE_THRESHOLD=0.55 — below this the Laya selection engine
#     delegates to the chat fallback.
#   LAYA_TIMEOUT_MS=5000 — per-request timeout for laya-serve calls.
#   LAYA_MAX_OPTIONS=12 — cap enforced on choice-question options.
#   LAYA_SALIENCE_THRESHOLD=3 — salience score (1–5) below which model
#     memory/belief appends are dropped when LAYA_SALIENCE=1.
# --------------------------------------------------------------------------
# LAYA_URL=http://127.0.0.1:8000
# LAYA_MODE=off
# LAYA_SELECTION=0
# LAYA_JUDGE=0
# LAYA_TRIAGE=0
# LAYA_SALIENCE=0
# LAYA_PLANNER=0
# LAYA_PLAUSIBILITY=0
# LAYA_CONFIDENCE_THRESHOLD=0.55
# LAYA_TIMEOUT_MS=5000
# LAYA_MAX_OPTIONS=12
# LAYA_SALIENCE_THRESHOLD=3

# --------------------------------------------------------------------------
# Generation tuning (applies to whichever backend is active).
# Roleplay sweet spot: temperature 0.8-1.0, repeat_penalty 1.1-1.15.
# --------------------------------------------------------------------------
# LLM_TIMEOUT_MS=60000        — per-call timeout. When UNSET, the engine
#                               derives it from measured per-model latency
#                               (see "Model latency" below): 4x the median
#                               diagnose:ai:live probe, clamped 60s..600s.
#                               An explicit value always wins. The 60s
#                               default is built for hosted flash tiers —
#                               a local 14B needs ~300s (exp-6).
# LLM_TEMPERATURE=0.9
# LLM_REPEAT_PENALTY=1.1
# LLM_MAX_TOKENS=1500        — flat budget for every task. Thinking-class
#                               models (qwen3*) burn most of it on <think>
#                               tokens (exp-6: 1500/1500 hit, JSON cut).
#                               Prefer the per-task knobs below, or
#                               LLM_THINK=0.
#
# Thinking models (exp-6 item 3). qwen3/deepseek-r1/qwq emit
# chain-of-thought that counts against max_tokens on Ollama — the single
# biggest latency lever for JSON workloads (exp-6: median 772 completion
# tokens for ~100-token JSON payloads). Disabled by default below:
# thinking is pure cost for the JSON workers (measured cost, no measured
# benefit — see PR #3). Re-enable per experiment with LLM_THINK=1, or
# leave thinking on and raise budgets instead (multiplier below).
LLM_THINK=0                   # send think:false to Ollama: no reasoning
                              # tokens, ~3-5x faster calls, smaller budgets
                              # suffice. 1 (or unset) = model default.
                              # Only Ollama receives the flag.
# LLM_THINKING_TOKEN_MULTIPLIER=2
#                             — when thinking is on, scale the token budget
#                               up by this factor (explicit per-task
#                               LLM_MAX_TOKENS_* always wins).
#
# Model latency (exp-6 item 6). `npm run diagnose:ai:live` times 3 tiny
# completions against the hard-tier local model and records the median at
# ~/.cache/npc-simulator/llm-latency.json. The engine reads it back to
# derive the default LLM_TIMEOUT_MS above, and completeJson warns
# (<module>_slow_call) when one call exceeds half its timeout.

# --------------------------------------------------------------------------
# Per-task tuning (F14). Each LLM role gets its own temperature; unset roles
# fall back to LLM_TEMPERATURE. Classification roles (selection, semantic)
# want low temperature for determinism; creative roles want it high.
# --------------------------------------------------------------------------
# LLM_TEMPERATURE_PROPOSAL=0.9
# LLM_TEMPERATURE_SELECTION=0.2
# LLM_TEMPERATURE_CONSEQUENCE=0.9
# LLM_TEMPERATURE_SEMANTIC=0.2

# --------------------------------------------------------------------------
# Reliability (F11-F13). Failover + strict JSON output for flaky gateways.
# --------------------------------------------------------------------------
# LLM_FAILOVER_BACKEND=            — backend to try when the primary fails
#                                   (same values as LLM_BACKEND; unset = no failover)
# LLM_JSON_MODE=1                  — request response_format: {type:"json_object"}
#                                   from the gateway (default ON; set 0 to disable)

# --------------------------------------------------------------------------
# Input cost guard (F33). Caps prompt input size in chars; prompts are
# truncated to budget before the LLM call. Default 60000.
# --------------------------------------------------------------------------
# LLM_MAX_INPUT_CHARS=60000

# --------------------------------------------------------------------------
# Log privacy (F29). Full prompt/response bodies are stripped from LLM-call
# log records when 0; metadata (model, backend, latencies, token usage,
# error codes) is always kept. Default 1 (keep bodies).
# --------------------------------------------------------------------------
# NPC_LOG_PROMPTS=1

# --------------------------------------------------------------------------
# Graphic server security (F30).
#   HOST          — bind address. Default 127.0.0.1 (loopback only; the server
#                   is NOT reachable from the LAN). Set to 0.0.0.0 to expose
#                   it — only on a network you trust.
#   NPC_API_TOKEN — when set, POST /action, POST /reset, and GET /logs require
#                   an `x-api-token` header or `Authorization: Bearer <token>`
#                   (401 otherwise). Unset = no auth (previous behavior).
# --------------------------------------------------------------------------
# HOST=127.0.0.1
# NPC_API_TOKEN=
