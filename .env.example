# =============================================================================
# NPC Simulator — centralized configuration.
# Copy to `.env` and you are done:  cp .env.example .env
# Every value below is ACTIVE (uncommented) and set to the optimal default.
# `.env` is git-ignored; secrets must never be committed.
# =============================================================================
#
# TWO kinds of variables live here:
#   LLM_*     — read by the simulator itself.
#   OLLAMA_*  — read by the `ollama serve` daemon, NOT the simulator,
#               with one exception: OLLAMA_MODEL (which model the simulator
#               requests) is simulator-read despite its prefix.
#               The server-side OLLAMA_* only take effect if the server starts
#               with them in its environment: use `npm run ollama:serve`
#               (scripts/start-ollama.sh), which exports the OLLAMA_* lines
#               from `.env` before launching. Starting ollama any other way
#               silently ignores them.

# =============================================================================
# Ollama server — RTX 5070 Ti / 16 GB VRAM optimal defaults.
# Read by `ollama serve`; applied via `npm run ollama:serve`.
# =============================================================================
# Keep weights resident between turns (a turn fires several LLM calls;
# the 5m default would cold-start mid-run).
OLLAMA_KEEP_ALIVE=30m
# Serial workload — one request at a time. Avoids duplicate KV-cache slots
# competing for VRAM (default 4).
OLLAMA_NUM_PARALLEL=1
# Faster attention kernels on Blackwell; also enables KV-cache quantization.
OLLAMA_FLASH_ATTENTION=1

# =============================================================================
# Backend selection — tiered routing (PLAN_V2: two LLM calls per turn).
#   LLM_BACKEND        — hard tasks: consequence (narration)
#   LLM_SIMPLE_BACKEND — simple tasks: intent + semantic
#   joingonka  — hosted gateway (needs JOINGONKA_API_KEY below)
#   laya-local — locally served model (needs `npm run setup:laya` first)
#   ollama     — local Ollama server (needs `npm run setup:ollama` first)
#
# Default is all-local ollama: it works out of the box (no API key) and it
# is the measured configuration — every v2 acceptance run (14B and 8B) ran
# with LLM_BACKEND=ollama. Switch the hard tier to joingonka (+ key below)
# only if you want hosted narration instead of local.
# Per-task overrides (LLM_BACKEND_INTENT / _CONSEQUENCE / _SEMANTIC) are
# intentionally NOT set: unset = follow the tier defaults above. Setting
# them pins a value that goes stale when you change the tier.
# Simple-tier model override, e.g. LLM_SIMPLE_MODEL=fluffy/l3-8b-stheno-v3.2
# Override per run without editing this file:
#   npm run start:text -- --provider ollama --model qwen3:14b
# =============================================================================
LLM_BACKEND=ollama
LLM_SIMPLE_BACKEND=ollama

# =============================================================================
# Hosted provider — JoinGonka gateway (OpenAI-compatible).
# Get an API key at https://gate.joingonka.ai/dashboard
# =============================================================================
JOINGONKA_API_KEY=
JOINGONKA_BASE_URL=https://gate.joingonka.ai/v1
JOINGONKA_MODEL=zai-org/GLM-5.3-Flash

# =============================================================================
# laya-local provider — a model served on this machine behind an
# OpenAI-compatible endpoint (llama.cpp --server, Ollama, vLLM, ...).
# Only needed when LLM_BACKEND=laya-local.
# =============================================================================
# LAYA_BASE_URL=http://127.0.0.1:8080/v1
# LAYA_MODEL=laya
# LAYA_API_KEY=
# NOTE: `npm run serve:laya` exposes the Jev-compatible typed-decisions API at
# POST http://127.0.0.1:8000/v1/systemone — that is NOT an OpenAI Chat
# Completions endpoint, so do NOT point LAYA_BASE_URL at it.

# =============================================================================
# Ollama provider — any model served by `ollama serve` behind its
# OpenAI-compatible endpoint. Recommended models (pulled by
# `npm run setup:ollama`):
#   qwen3:14b                         — Qwen3 14B (default primary, ~9.3 GB; Exp-6)
#   fluffy/l3-8b-stheno-v3.2          — L3 8B Stheno (legacy primary, ~4.9 GB)
#   huihui_ai/llama3.2-abliterate:3b  — Llama 3.2 3B abliterated (fast, ~2.2 GB)
# =============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Default model — must be one that `npm run setup:ollama` actually pulls.
# NOTE: despite the prefix, OLLAMA_MODEL is read by the SIMULATOR (which
# model to request), not by `ollama serve`. Default is the tuned variant
# npc-qwen3-14b (full GPU offload via num_gpu 999, num_ctx 4096, num_batch
# 1024 — built idempotently by `npm run setup:ollama`, shares the base
# weights so it costs no extra disk). Fall back to stock qwen3:14b if you
# skipped setup.
OLLAMA_MODEL=npc-qwen3-14b
# OLLAMA_API_KEY=  — local Ollama needs no key; only for remote gateways.

# =============================================================================
# serve-laya.sh settings — the Laya decision-model server.
# =============================================================================
LAYA_SERVE_URL=http://127.0.0.1:8000
LAYA_DEVICE=cpu
LAYA_PRELOAD=1
LAYA_PYTHON=python3
# LAYA_VENV=  — defaults to <repo>/.laya-venv; set only for a custom venv path.

# =============================================================================
# Laya semantic layer (PLAN_V2 Phase 6).
#
# Laya survives as exactly two things: the semantic parser (one batched
# local decide over the action sentence — Laya as parser, never decider)
# and the locomotion veto (a physics guard on planned moves).
#
#   LAYA_URL=http://127.0.0.1:8000 — laya-serve endpoint (POST /v1/systemone).
#   LAYA_MODE=off|on — off disables Laya entirely (the parser falls back
#     to deterministic text parsing); on (default) enables the parser +
#     veto. Legacy "static"/"dynamic" values map to on.
#   LAYA_LOCOMOTION=0|1 — the locomotion veto (default 1). Laya only ever
#     VETOES a planned move it is confident needs no relocation.
#   LAYA_TIMEOUT_MS — decide timeout in ms (default 5000).
# The old cascade toggles (LAYA_SELECTION / _JUDGE / _TRIAGE / _SALIENCE /
# _PLANNER / _PLAUSIBILITY / _SALVAGE_SELECT / _RENDERABILITY) are deleted
# with the decision cascade — setting them does nothing.
# =============================================================================
LAYA_URL=http://127.0.0.1:8000
LAYA_MODE=on
LAYA_LOCOMOTION=1
LAYA_TIMEOUT_MS=5000

# =============================================================================
# Generation tuning.
# =============================================================================
# Per-call timeout. 120s is the backstop for the think-off regime (calls
# run ~15–30s; warnings fire past 50%). Two smarter alternatives:
#   - comment this out → the engine derives the default from measured
#     per-model latency (`npm run diagnose:ai:live` → 4× median, 60s…600s);
#   - re-enable thinking (LLM_THINK=1) → raise this to 300000 (exp-6 max
#     call was 242s with thinking on).
# An explicit value always wins over the derived default.
LLM_TIMEOUT_MS=120000
# LLM_TEMPERATURE=0.9 — the one-knob alternative to the per-task values
# below (chain: LLM_TEMPERATURE_<TASK> → LLM_TEMPERATURE → built-in default).
LLM_REPEAT_PENALTY=1.1
# Flat budget for every task. Thinking-class models (qwen3*) burn most of it
# on <think> tokens — with LLM_THINK=0 below, 1500 is generous headroom for
# the small JSON payloads this engine emits.
LLM_MAX_TOKENS=1500
# Thinking models (qwen3/deepseek-r1/qwq): chain-of-thought counts against
# max_tokens on Ollama — the single biggest latency lever for JSON workloads
# (exp-6: median 772 completion tokens for ~100-token JSON payloads).
# Disabled: thinking is measured cost with no measured benefit for the JSON
# workers (see PR #3). 1 = model default (flag not sent). Only Ollama
# receives the flag; hosted providers never see it.
# NOTE (2026-10-09): on current Ollama builds qwen3 emits no <think> output
# for these prompts either way (verified with `npm run probe:think`), and
# this file's LLM_THINK=0 is backfilled when the var is unset — so the flag
# is currently belt-and-braces, not the lever. Do not spend runs re-testing
# it; the remaining latency lever is per-call prompt ingest + generation.
LLM_THINK=0
# When thinking is ON and no per-task cap below is set, scale the budget up
# by this factor (explicit per-task LLM_MAX_TOKENS_* always wins).
LLM_THINKING_TOKEN_MULTIPLIER=2
# Model latency (exp-6 item 6): `npm run diagnose:ai:live` times 3 tiny
# completions against the hard-tier local model and records the median at
# ~/.cache/npc-simulator/llm-latency.json. With LLM_TIMEOUT_MS commented
# out, the engine derives its default from that cache; completeJson warns
# (<module>_slow_call) when one call exceeds half its timeout.

# =============================================================================
# Per-task token budgets (F14 + exp-6 item 6) — proportional to payload.
# Task names are the v2 tasks: intent (one action sentence + quote),
# consequence (narration), semantic (Laya parse — local, barely uses this).
# NOTE: explicit caps win over LLM_THINKING_TOKEN_MULTIPLIER. If you
# re-enable thinking for an experiment, raise these (or unset them) —
# otherwise a thinking model capped at 1500 will truncate again.
# =============================================================================
LLM_MAX_TOKENS_INTENT=800
LLM_MAX_TOKENS_CONSEQUENCE=1500
LLM_MAX_TOKENS_SEMANTIC=500

# =============================================================================
# Per-task temperatures (F14). The intent call wants some variance (lively
# actions) but must stay coherent; consequence carries the prose; semantic
# is a parser and wants determinism.
# Chain: LLM_TEMPERATURE_<TASK> → LLM_TEMPERATURE → built-in default.
# =============================================================================
LLM_TEMPERATURE_INTENT=0.7
# Exp-7 item A11: consequence was 0.9 — exp-7 measured ~730-token median
# completions for ~100-token JSON payloads and 11 finish_reason=length
# truncations on a 1500 budget. The consequence call is mostly a
# structured-emission task wearing a creative hat; 0.5 curbs the verbosity
# (fewer truncations -> fewer retries -> faster turns) while keeping prose
# natural. Validate with: npm run probe:think (exp-7 item A3).
LLM_TEMPERATURE_CONSEQUENCE=0.5
LLM_TEMPERATURE_SEMANTIC=0.2

# =============================================================================
# User-turn routing (exp-4 S1). 1 = route the human player's turns through
# the capable (hard) tier; the player's typed speech is ground truth and
# must be preserved verbatim. 0 = standard tier routing for user turns.
# (No-op with a warning when both tiers resolve to the same provider+model.)
# =============================================================================
LLM_USER_CAPABLE_TIER=1

# =============================================================================
# Turn-time budget (PLAN_V2). Wall-time budget per turn, in ms. When a turn
# crosses it, the orchestrator logs a loud `turn_time_exceeded` event —
# the turn is NEVER aborted (a slow turn that avoids a fallback beats a
# fast fallback). Read by the UI wiring into EngineConfig. Anton's hard
# line: 30 s.
# =============================================================================
TURN_TIME_BUDGET_MS=30000

# =============================================================================
# Reliability (F11-F13). Failover + strict JSON output for flaky gateways.
# =============================================================================
# LLM_FAILOVER_BACKEND= — backend to try when the primary fails (same values
#   as LLM_BACKEND; unset = no failover). Optional: only set it if you have
#   a second working backend (e.g. primary ollama → failover joingonka).
LLM_JSON_MODE=1

# =============================================================================
# Input cost guard (F33). Caps prompt input size in chars; prompts are
# truncated to budget before the LLM call.
# =============================================================================
LLM_MAX_INPUT_CHARS=60000

# =============================================================================
# Log privacy (F29). Full prompt/response bodies are stripped from LLM-call
# log records when 0; metadata (model, backend, latencies, token usage,
# error codes) is always kept.
# =============================================================================
NPC_LOG_PROMPTS=1

# =============================================================================
# Graphic server security (F30).
#   HOST          — bind address. 127.0.0.1 = loopback only (NOT reachable
#                   from the LAN). 0.0.0.0 exposes it — only on a trusted net.
#   NPC_API_TOKEN — when set, POST /action, POST /reset, and GET /logs require
#                   an `x-api-token` header or `Authorization: Bearer <token>`
#                   (401 otherwise). SET THIS if you ever bind 0.0.0.0.
# =============================================================================
HOST=127.0.0.1
NPC_API_TOKEN=
