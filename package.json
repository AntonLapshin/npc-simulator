{
  "name": "npc-simulator",
  "version": "0.1.0",
  "description": "NPC Simulator — turn-based, open-ended life simulation platform (Milestone 1: deterministic engine core)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "bash scripts/start.sh",
    "start:text": "tsx src/ui/text/textUi.ts",
    "start:graphic": "tsx src/ui/graphic/server.ts",
    "bundle:graphic": "node src/ui/graphic/tools/bundle.mjs",
    "test:graphic": "node src/ui/graphic/tests/smoke.mjs && node src/ui/graphic/tools/bundle.mjs && node src/ui/graphic/tests/dom.mjs",
    "test:graphic:smoke": "node src/ui/graphic/tests/smoke.mjs",
    "test:graphic:dom": "node src/ui/graphic/tests/dom.mjs",
    "test:graphic:render": "node src/ui/graphic/tests/render.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "setup:laya": "bash scripts/setup-laya.sh",
    "serve:laya": "bash scripts/serve-laya.sh",
    "setup:ollama": "bash scripts/setup-ollama.sh",
    "diagnose": "tsx scripts/diagnose.ts",
    "diagnose:ui": "tsx scripts/diagnose-ui.ts",
    "diagnose:ai": "tsx scripts/diagnose-ai.ts",
    "diagnose:ai:live": "tsx scripts/diagnose-ai.ts --live",
    "eval:run-quality": "tsx scripts/eval-run-quality.ts",
    "clean:logs": "rm -rf logs && mkdir logs",
    "clean:saves": "rm -rf saves && mkdir saves",
    "clean": "npm run clean:logs && npm run clean:saves",
    "ollama:serve": "bash scripts/start-ollama.sh"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
